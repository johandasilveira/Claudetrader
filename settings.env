# =====================================================================
#  Réglages du bot, versionnés dans git (AUCUN secret ici).
#  Modifiables depuis Claude Code ; sur la machine : git pull && docker compose up -d bot
#  Le fichier .env local (identifiants, réglages machine) a priorité sur celui-ci.
# =====================================================================

# ---- Passerelle IBKR ----
TRADING_MODE=live
AUTO_RESTART_TIME=11:59 PM
TIME_ZONE=Europe/Paris
TZ=Europe/Paris

# ---- Claude ----
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=high

# ---- Univers et cadence ----
SYMBOLS=AAPL,MSFT,SPY
EXCHANGE=SMART
CURRENCY=USD
INTERVAL_MINUTES=30
BAR_SIZE=1 hour
HISTORY_DURATION=10 D

# ---- Garde-fous (compte de test à 30 EUR) ----
MAX_ORDER_VALUE=10
MAX_POSITION_VALUE=15
MAX_DAILY_LOSS=3
MAX_ORDERS_PER_DAY=2
MAX_LIMIT_DEVIATION_PCT=3
MIN_ORDER_VALUE=5
ALLOW_SHORT=false
ALLOW_FRACTIONAL=true

# ---- Mode ----
# true : observe et journalise sans envoyer d'ordre. false : envoie les ordres approuvés
# (exige en plus LIVE_TRADING_CONFIRM dans le .env local).
DRY_RUN=false
