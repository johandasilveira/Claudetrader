# =====================================================================
#  Réglages du bot, versionnés dans git (AUCUN secret ici).
#  Modifiables depuis Claude Code ; sur la machine : git pull && docker compose up -d bot
#  Le fichier .env local (identifiants, réglages machine) a priorité sur celui-ci.
# =====================================================================

# ---- Passerelle IBKR ----
TRADING_MODE=live
AUTO_RESTART_TIME=11:59 PM
TIME_ZONE=Europe/Paris
TZ=Europe/Paris

# ---- Origine des décisions ----
# analyst : Claude analyse le marché en session planifiée et dépose ses plans dans orders/ ;
#           le bot les exécute, sans aucun appel à l'API Claude.
# claude_api : le bot interroge lui-même l'API Claude à chaque cycle (ancien mode).
DECISION_SOURCE=analyst

# Titres que le bot accepte d'ACHETER (les ventes ne sont jamais bloquées). Tout achat hors liste est rejeté.
SYMBOLS=AAPL,MSFT,NVDA,AMZN,GOOGL,META,TSLA,AVGO,AMD,NFLX,ADBE,CRM,ORCL,INTC,QCOM,MU,JPM,BAC,GS,V,MA,UNH,LLY,JNJ,ABBV,MRK,PFE,XOM,CVX,WMT,COST,HD,MCD,KO,PEP,NKE,DIS,BA,CAT,GE,UBER,PLTR,SPY,QQQ,IWM
EXCHANGE=SMART
CURRENCY=USD

# Le bot vérifie toutes les 3 minutes, pendant la séance seulement : nouveaux plans à exécuter
# et sorties mécaniques des positions. Ces vérifications ne coûtent rien (aucun appel à Claude).
INTERVAL_MINUTES=3
TRADE_HOURS_ONLY=true
SKIP_FIRST_MINUTES=0

# Utilisés seulement en mode claude_api.
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=high
BAR_SIZE=1 day
HISTORY_DURATION=3 M

# ---- Garde-fous (compte d'environ 430 USD) ----
# IBKR refuse les fractions d'action passées par l'API (erreur 10243) : actions entières uniquement.
# Ordre de 80 à 200 USD : une action de tout titre coté jusqu'à 200 $ reste accessible, et la
# commission (~1 USD) pèse au plus 1,25 %. Un stop à -3 % sur 200 $ coûte 6 $, soit 1,4 % du capital.
MIN_ORDER_VALUE=80
MAX_ORDER_VALUE=200
MAX_POSITION_VALUE=210
MAX_OPEN_POSITIONS=2
# Sorties mécaniques appliquées par le bot à chaque vérification, même si l'analyste ne passe pas.
STOP_LOSS_PCT=3
TAKE_PROFIT_PCT=5
# 12 USD, soit 3 % du capital : au-delà, plus aucun achat de la journée.
MAX_DAILY_LOSS=12
MAX_ORDERS_PER_DAY=2
MAX_LIMIT_DEVIATION_PCT=3
ALLOW_SHORT=false
ALLOW_FRACTIONAL=false

# ---- Mode ----
# true : observe et journalise sans envoyer d'ordre. false : envoie les ordres approuvés
# (exige en plus LIVE_TRADING_CONFIRM dans le .env local).
DRY_RUN=false
