# =====================================================================
#  Réglages du bot, versionnés dans git (AUCUN secret ici).
#  Modifiables depuis Claude Code ; sur la machine : git pull && docker compose up -d bot
#  Le fichier .env local (identifiants, réglages machine) a priorité sur celui-ci.
# =====================================================================

# ---- Passerelle IBKR ----
TRADING_MODE=live
AUTO_RESTART_TIME=11:59 PM
TIME_ZONE=Europe/Paris
TZ=Europe/Paris

# ---- Claude ----
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=high

# ---- Univers et cadence ----
# Dix grandes valeurs américaines très liquides, de secteurs différents.
SYMBOLS=AAPL,MSFT,SPY,NVDA,AMZN,GOOGL,META,TSLA,AMD,JPM
EXCHANGE=SMART
CURRENCY=USD
# Bougies journalières sur trois mois : l'horizon d'une stratégie swing.
BAR_SIZE=1 day
HISTORY_DURATION=3 M
# Trois cycles par séance : 30 min après l'ouverture, en milieu de séance, une heure avant la clôture
# (10h00, 12h30 et 15h00 à New York). Avec des bougies journalières, c'est suffisant.
# Hors séance aucun appel à Claude n'est fait.
INTERVAL_MINUTES=150
TRADE_HOURS_ONLY=true
# Les 30 premières minutes après l'ouverture sont les plus volatiles : on les laisse passer.
SKIP_FIRST_MINUTES=30

# ---- Garde-fous (compte d'environ 400 EUR) ----
# Ordre de 80 à 130 USD : la commission (~1 USD) reste sous 1,3 % du montant.
MIN_ORDER_VALUE=80
MAX_ORDER_VALUE=130
MAX_POSITION_VALUE=150
MAX_OPEN_POSITIONS=2
# 12 USD, soit 3 % du capital : au-delà, plus aucun achat de la journée.
MAX_DAILY_LOSS=12
MAX_ORDERS_PER_DAY=2
MAX_LIMIT_DEVIATION_PCT=3
ALLOW_SHORT=false
ALLOW_FRACTIONAL=true

# ---- Mode ----
# true : observe et journalise sans envoyer d'ordre. false : envoie les ordres approuvés
# (exige en plus LIVE_TRADING_CONFIRM dans le .env local).
DRY_RUN=false
