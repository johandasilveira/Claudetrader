# ---- Interactive Brokers (IB Gateway ou TWS) ----
# Ports par défaut : IB Gateway papier 4002, IB Gateway réel 4001, TWS papier 7497, TWS réel 7496
IB_HOST=127.0.0.1
IB_PORT=4002
IB_CLIENT_ID=7
# Laisser vide pour le compte par défaut de la session (ex : DU1234567 en papier)
IB_ACCOUNT=

# ---- Claude ----
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=high

# ---- Univers et cadence ----
SYMBOLS=AAPL,MSFT,SPY
EXCHANGE=SMART
CURRENCY=USD
INTERVAL_MINUTES=30
BAR_SIZE=1 hour
HISTORY_DURATION=10 D

# ---- Garde-fous (en devise du compte) ----
MAX_ORDER_VALUE=1000
MAX_POSITION_VALUE=3000
MAX_DAILY_LOSS=200
MAX_ORDERS_PER_DAY=6
MAX_LIMIT_DEVIATION_PCT=3
ALLOW_SHORT=false

# ---- Sécurité ----
# true : le bot raisonne et journalise mais n'envoie AUCUN ordre
DRY_RUN=true
# Obligatoire pour autoriser un port réel (4001 / 7496). Laisser vide sinon.
LIVE_TRADING_CONFIRM=
