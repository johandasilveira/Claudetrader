# =====================================================================
#  Secrets et réglages propres à cette machine. Copie en .env, jamais dans git.
#  Tout le reste (univers, limites, DRY_RUN...) est dans settings.env, versionné.
# =====================================================================

# Identifiants IBKR (utilisés uniquement par le conteneur ib-gateway)
TWS_USERID=ton_identifiant_ibkr
TWS_PASSWORD=ton_mot_de_passe_ibkr

# Clé API Claude
ANTHROPIC_API_KEY=sk-ant-...

# Notifications sur le téléphone via l'appli gratuite ntfy. Choisis un nom long et
# impossible à deviner : quiconque le connaît peut lire les messages. Vide = pas de notification.
NTFY_TOPIC=

# Obligatoire pour envoyer des ordres sur un compte réel (avec DRY_RUN=false). Phrase exacte :
# LIVE_TRADING_CONFIRM=I_UNDERSTAND_THIS_TRADES_REAL_MONEY
LIVE_TRADING_CONFIRM=

# Facultatif : compte IBKR si plusieurs (ex : U1234567), mot de passe VNC, mémoire Java (512 sur 1 Go)
IB_ACCOUNT=
VNC_SERVER_PASSWORD=
JAVA_HEAP_SIZE=512

# Facultatif, hors Docker uniquement : où tourne IB Gateway (4001 live / 4002 paper)
IB_HOST=127.0.0.1
IB_PORT=4001
IB_CLIENT_ID=7
