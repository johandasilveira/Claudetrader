# =====================================================================
#  Claudetrader : configuration. Copie ce fichier en .env et remplis-le.
# =====================================================================

# ---- Identifiants IBKR (utilisés UNIQUEMENT par le conteneur ib-gateway) ----
TWS_USERID=ton_identifiant_ibkr
TWS_PASSWORD=ton_mot_de_passe_ibkr
# live ou paper
TRADING_MODE=live
# Heure de redémarrage quotidien de la passerelle (évite la double authentification quotidienne)
AUTO_RESTART_TIME=11:59 PM
TIME_ZONE=Europe/Paris
# Mot de passe VNC pour voir la fenêtre de la passerelle via tunnel SSH (vide = VNC désactivé)
VNC_SERVER_PASSWORD=

# ---- Connexion du bot à la passerelle ----
# En local (IB Gateway installé sur la machine) : 4001 live, 4002 paper.
# En Docker, IB_HOST et IB_PORT sont écrasés par docker-compose (ib-gateway:4003 live / 4004 paper).
IB_HOST=127.0.0.1
IB_PORT=4001
IB_CLIENT_ID=7
# Laisser vide pour le compte par défaut de la session (ex : U1234567)
IB_ACCOUNT=

# ---- Claude ----
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=high

# ---- Univers et cadence ----
SYMBOLS=AAPL,MSFT,SPY
EXCHANGE=SMART
CURRENCY=USD
INTERVAL_MINUTES=30
BAR_SIZE=1 hour
HISTORY_DURATION=10 D

# ---- Garde-fous (en devise du compte) ----
MAX_ORDER_VALUE=1000
MAX_POSITION_VALUE=3000
MAX_DAILY_LOSS=200
MAX_ORDERS_PER_DAY=6
MAX_LIMIT_DEVIATION_PCT=3
ALLOW_SHORT=false
# Fractions d'actions (ex : 0.03 AAPL). Exige la permission "Fractional Shares" activée chez IBKR.
ALLOW_FRACTIONAL=false
# Montant minimal d'un ordre : en dessous, les commissions (≈ 1 USD) mangent tout.
MIN_ORDER_VALUE=5

# ---- Sécurité ----
# true : le bot lit le compte, raisonne et journalise, mais n'envoie AUCUN ordre.
# Passe à false quand tu veux que les ordres approuvés partent réellement.
DRY_RUN=true
# Obligatoire pour envoyer des ordres sur un compte réel. Phrase exacte :
# LIVE_TRADING_CONFIRM=I_UNDERSTAND_THIS_TRADES_REAL_MONEY
LIVE_TRADING_CONFIRM=

# ---- Serveur à petite mémoire (ex : Google Cloud e2-micro, 1 Go de RAM) ----
# Mémoire Java de la passerelle en Mo. 1024 par défaut, 512 sur une machine à 1 Go.
# JAVA_HEAP_SIZE=512
